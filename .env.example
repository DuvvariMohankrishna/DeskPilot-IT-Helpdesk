# Copy this file to .env at the project root for local development.
# Never commit .env or place production secrets in source control.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
ALLOW_PUBLIC_REGISTRATION=False

# Local MySQL connection
DB_NAME=it_helpdesk
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: filesystem path to a provider CA certificate for managed MySQL TLS.
# DB_SSL_CA=
